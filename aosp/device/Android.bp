// SPDX-License-Identifier: Apache-2.0
//
// Xiaomi camera 6.8.002090.2 (Xiaomi 18 Pro, CN) for the Xiaomi 14 (houji).
//
// prebuilt/MiuiCamera.apk is not in this repository: build it from your own copy of the APK
// with aosp/tools/patch-apk.sh. The ROM build signs it with the platform key.
//
// This tree layers on the 6.4 houji-miuicamera device and vendor trees, which keep providing
// the camera's JNI libraries and shims; MiuiCamera68 takes the place of their MiuiCamera.

soong_namespace {
}

android_app_import {
    name: "MiuiCamera68",
    owner: "xiaomi",
    apk: "prebuilt/MiuiCamera.apk",
    certificate: "platform",
    privileged: true,
    dex_preopt: {
        enabled: false,
    },
    overrides: [
        "MiuiCamera",
        "Aperture",
        "Camera2",
        "Snap",
    ],
    required: [
        "MiuiCameraIconOverlay",
    ],
}

runtime_resource_overlay {
    name: "MiuiCameraIconOverlay",
    manifest: "overlay/MiuiCameraIconOverlay/AndroidManifest.xml",
    resource_dirs: ["overlay/MiuiCameraIconOverlay/res"],
    product_specific: true,
}
